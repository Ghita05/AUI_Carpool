{
  "name": "aui-carpooling-backend",
  "version": "2.0.0",
  "description": "Backend for AUI Carpooling Platform — EGR 4402 Capstone (Sprint 4)",
  "main": "src/server.js",
  "scripts": {
    "start": "node --max-old-space-size=460 src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest tests/unit --verbose",
    "test:coverage": "jest tests/unit --coverage --verbose",
    "seed:admin": "node scripts/seed-admin.js"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/unit/**/*.test.js"
    ]
  },
  "author": "Ghita Nafa",
  "license": "ISC",
  "dependencies": {
    "@googlemaps/google-maps-services-js": "^3.4.2",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^8.0.6",
    "resend": "^6.12.2",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.0"
  },
  "devDependencies": {
    "jest": "^30.3.0",
    "nodemon": "^3.1.7"
  }
}
