{
  "buildCommand": "",
  "outputDirectory": ".",
  "framework": null,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/_expo/(.*)", "destination": "/_expo/$1" },
    { "source": "/((?!assets|_expo|favicon\\.ico).*)", "destination": "/index.html" }
  ]
}
